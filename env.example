# Copy to .env (or set these in your host's "Environment variables" screen). Never commit real values.

# --- Pharmacist dashboard (first start only; change it later inside the dashboard) ---
ADMIN_PASSWORD=choose-a-long-password-here

# --- Fax ---
PHARMACY_FAX=613-691-7667
FAX_PROVIDER=documo            # documo | phaxio  (dryrun = testing only, does NOT fax)
DOCUMO_API_KEY=                # if FAX_PROVIDER=documo
PHAXIO_API_KEY=                # if FAX_PROVIDER=phaxio
PHAXIO_API_SECRET=

# --- Server ---
PORT=3000
DATA_DIR=./data                # needs a persistent disk; holds only hours, booked times, password hash
COOKIE_SECURE=1                # keep on when the site is served over https
TRUST_PROXY=1                  # on if your host puts a proxy in front (Render, Railway, Fly, Nginx)
PHARMACY_TZ=America/Toronto
